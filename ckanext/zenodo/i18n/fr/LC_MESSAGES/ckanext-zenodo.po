#: ckanext/zenodo/assets/js/zenodo-chunked-upload.js:128
#: ckanext/zenodo/templates/package/snippets/resource_form.html:24
msgid "Upload to Zenodo failed"
msgstr "L'envoi vers Zenodo a échoué"

# | msgid "Network error."
#: ckanext/zenodo/assets/js/zenodo-chunked-upload.js:137
#: ckanext/zenodo/assets/js/zenodo-chunked-upload.js:182
#: ckanext/zenodo/templates/package/snippets/resource_form.html:25
msgid "Network error"
msgstr "Erreur réseau"

#: ckanext/zenodo/assets/js/zenodo-chunked-upload.js:154
msgid "Upload cancelled"
msgstr "Envoi annulé"

#: ckanext/zenodo/lib/auth.py:40
msgid ""
"Can't delete the last file of a published Zenodo record - Zenodo has no "
"way to publish a version with no files at all. Add a replacement file "
"first, or ask an administrator to resolve this dataset's Zenodo archive "
"another way."
msgstr ""
"Impossible de supprimer le dernier fichier d'un enregistrement Zenodo "
"publié - Zenodo ne permet pas de publier une version sans aucun fichier. "
"Ajoutez d'abord un fichier de remplacement, ou demandez à un "
"administrateur de régler l'archive Zenodo de ce dataset autrement."

#: ckanext/zenodo/lib/chunked_upload.py:65
msgid "Zenodo could not be reached or refused the file."
msgstr "Zenodo n'a pas pu être joint ou a refusé le fichier."

#: ckanext/zenodo/lib/chunked_upload.py:66
msgid "The transfer to Zenodo was interrupted."
msgstr "Le transfert vers Zenodo a été interrompu."

#: ckanext/zenodo/lib/chunked_upload.py:67
msgid "Zenodo isn't set up on this site any more."
msgstr "Zenodo n'est plus configuré sur ce site."

#: ckanext/zenodo/lib/helpers.py:75
msgid "Archived on Zenodo"
msgstr "Archivé sur Zenodo"

#: ckanext/zenodo/lib/helpers.py:76
msgid "Zenodo archive updated"
msgstr "Archive Zenodo mise à jour"

#: ckanext/zenodo/lib/lifecycle_guard.py:94
#, python-brace-format
msgid ""
"\"{title}\" was purged, but its files stay publicly archived on Zenodo: "
"{record}. A published Zenodo record can't be deleted from here - only "
"Zenodo support can remove it."
msgstr ""
"« {title} » a été purgé, mais ses fichiers restent archivés publiquement "
"sur Zenodo : {record}. Un enregistrement Zenodo publié ne peut pas être "
"supprimé d'ici - seul le support Zenodo peut le retirer."

#: ckanext/zenodo/lib/lifecycle_guard.py:138
#, python-brace-format
msgid ""
"The files of \"{title}\" stored on Zenodo (not yet published) were "
"deleted too."
msgstr ""
"Les fichiers de « {title} » stockés sur Zenodo (pas encore publiés) ont "
"aussi été supprimés."

#: ckanext/zenodo/lib/lifecycle_guard.py:145
#, python-brace-format
msgid ""
"\"{title}\" was deleted, but its files stay publicly archived on Zenodo: "
"{record}. A published Zenodo record can't be deleted from here - only "
"Zenodo support can remove it."
msgstr ""
"« {title} » a été supprimé, mais ses fichiers restent archivés "
"publiquement sur Zenodo : {record}. Un enregistrement Zenodo publié ne "
"peut pas être supprimé d'ici - seul le support Zenodo peut le retirer."

#: ckanext/zenodo/lib/lifecycle_guard.py:183
#, python-brace-format
msgid ""
"\"{title}\" is now private, but its files already archived on Zenodo stay"
" public: {record}. A published Zenodo record can't be made private."
msgstr ""
"« {title} » est maintenant privé, mais ses fichiers déjà archivés sur "
"Zenodo restent publics : {record}. Un enregistrement Zenodo publié ne "
"peut pas être rendu privé."

#: ckanext/zenodo/templates/package/confirm_delete.html:9
msgid ""
"Its files stored on Zenodo (not yet published) will be deleted too. They "
"can't be recovered, even if the dataset is restored later."
msgstr ""
"Ses fichiers stockés sur Zenodo (pas encore publiés) seront aussi "
"supprimés. Ils ne pourront pas être récupérés, même si le dataset est "
"restauré plus tard."

#: ckanext/zenodo/templates/package/confirm_delete.html:13
msgid ""
"Its files already published on Zenodo will stay public there - a "
"published Zenodo record can't be deleted from here."
msgstr ""
"Ses fichiers déjà publiés sur Zenodo y resteront publics - un "
"enregistrement Zenodo publié ne peut pas être supprimé d'ici."

#: ckanext/zenodo/templates/package/snippets/resource_form.html:21
msgid ""
"Files larger than the limit, or in a format the data viewer cannot read, "
"go to Zenodo automatically."
msgstr ""
"Les fichiers plus gros que la limite, ou dans un format que la "
"visionneuse de données ne sait pas lire, vont automatiquement sur Zenodo."

#: ckanext/zenodo/templates/package/snippets/resource_form.html:22
msgid "This file will be stored on Zenodo, not in this catalogue."
msgstr "Ce fichier sera stocké sur Zenodo, pas dans ce catalogue."

#: ckanext/zenodo/templates/package/snippets/resource_form.html:23
msgid "Uploading to Zenodo…"
msgstr "Envoi vers Zenodo…"

#: ckanext/zenodo/templates/package/snippets/resource_form.html:30
msgid "Store this file on Zenodo instead of this catalogue"
msgstr "Stocker ce fichier sur Zenodo plutôt que dans ce catalogue"

#: ckanext/zenodo/templates/package/snippets/resource_form.html:35
msgid "Cancel"
msgstr "Annuler"

#: ckanext/zenodo/templates/package/snippets/resources_list.html:39
msgid "Close"
msgstr "Fermer"

#: ckanext/zenodo/templates/package/snippets/resources_list.html:57
msgid "Upload not finished - it is removed after two hours without news."
msgstr "Envoi non terminé - il est supprimé après deux heures sans nouvelles."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:59
msgid "Sending to Zenodo failed:"
msgstr "L'envoi vers Zenodo a échoué :"

#: ckanext/zenodo/templates/package/snippets/resources_list.html:62
msgid "Another attempt is made automatically within the next hour."
msgstr "Une nouvelle tentative est faite automatiquement dans l'heure."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:64
msgid ""
"No more automatic attempts: retry it, or remove it (it is removed after a"
" day otherwise)."
msgstr ""
"Plus de nouvelle tentative automatique : réessayez, ou supprimez-le "
"(sinon il est supprimé au bout d'un jour)."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:67
msgid "Cancelled - it disappears in a moment."
msgstr "Annulé - disparaît dans un instant."

# | msgid "Being archived on Zenodo - reload this page in a moment to see it."
#: ckanext/zenodo/templates/package/snippets/resources_list.html:69
msgid "Received - being sent to Zenodo, reload this page in a moment."
msgstr "Reçu - envoi vers Zenodo en cours, rechargez cette page dans un instant."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:77
msgid "Retry"
msgstr "Réessayer"

#: ckanext/zenodo/templates/package/snippets/resources_list.html:82
#: ckanext/zenodo/templates/package/snippets/resources_list.html:84
#: ckanext/zenodo/templates/package/snippets/resources_list.html:165
#: ckanext/zenodo/templates/package/snippets/resources_list.html:191
#: ckanext/zenodo/templates/package/snippets/resources_list.html:215
#: ckanext/zenodo/templates/package/snippets/resources_list.html:220
msgid "Remove"
msgstr "Supprimer"

# | msgid "Could not remove the file - try again shortly."
#: ckanext/zenodo/templates/package/snippets/resources_list.html:111
msgid "Could not do it - try again shortly."
msgstr "Impossible pour le moment - réessayez dans un instant."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:115
#: ckanext/zenodo/templates/package/snippets/resources_list.html:221
msgid "Network error."
msgstr "Erreur réseau."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:125
msgid ""
"Uploaded to Zenodo - won't be archived with a public DOI until this "
"dataset itself is made public."
msgstr ""
"Envoyé sur Zenodo - ne sera archivé avec un DOI public que lorsque ce "
"dataset sera lui-même rendu public."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:127
msgid ""
"Archiving on Zenodo keeps failing - please contact the site "
"administrators."
msgstr ""
"L'archivage sur Zenodo échoue à répétition - veuillez contacter les "
"administrateurs du site."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:129
msgid "Being archived on Zenodo - reload this page in a moment to see it."
msgstr ""
"Archivage sur Zenodo en cours - rechargez cette page dans un instant pour"
" le voir."

#: ckanext/zenodo/templates/package/snippets/resources_list.html:194
msgid "Removing…"
msgstr "Suppression…"

#: ckanext/zenodo/templates/package/snippets/resources_list.html:216
msgid "Could not remove the file - try again shortly."
msgstr "Impossible de supprimer le fichier - réessayez dans un instant."

